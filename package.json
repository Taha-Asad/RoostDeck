{
  "name": "roost-deck-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "The Roost Command Deck — Sovereign Gamified Life Engine & Decoupled Cross-Platform Ecosystem",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
