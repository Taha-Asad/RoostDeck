{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "The Roost Command Deck",
  "version": "0.1.0",
  "identifier": "com.thefallencrow.roostdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Roost Command Deck — The Fallen Crow",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#07080B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
